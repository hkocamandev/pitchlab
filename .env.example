# Copy to .env, or run `make secrets` to generate one with real values.
#
# .env is gitignored; this file is the committed template and must never
# contain a working secret.

# Signs session tokens. At least 32 bytes, and not a word.
#
# There is no default anywhere in the code. A service that falls back to a
# built-in signing key is a service whose tokens anyone holding this
# repository can forge, and nothing about it looks wrong at runtime.
#
#   openssl rand -base64 48
PITCHLAB_JWT_SECRET=

# The first administrator, created by `make seed`.
#
# Leave the password empty and the seed command generates one and prints it
# once. Set it only for a disposable local stack.
PITCHLAB_ADMIN_USER=admin
PITCHLAB_ADMIN_PASSWORD=
