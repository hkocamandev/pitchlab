{
  "uid": "pitchlab-pipeline",
  "title": "PitchLab \u00b7 Event Pipeline",
  "description": "Consumer lag is the number that matters: if it climbs, the system is not keeping up with what is being produced.",
  "tags": [
    "pitchlab",
    "operations",
    "kafka"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Consumer lag by partition",
      "description": "The single most important metric in the pipeline. Computed from the group's committed offsets against each partition's log end and sampled every ten seconds -- a reader inside a consumer group cannot report its own lag, and the -1 the library returns would be worse than nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "pitchlab-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pitchlab-prometheus"
          },
          "expr": "kafka_consumer_lag",
          "legendFormat": "{{topic}} p{{partition}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Messages consumed per second",
      "description": "result is ok / duplicate / dlq. A steady stream of duplicates is idempotency working, not a fault.",
      "datasource": {
        "type": "prometheus",
        "uid": "pitchlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pitchlab-prometheus"
          },
          "expr": "sum by (topic, result) (rate(kafka_messages_consumed_total[1m]))",
          "legendFormat": "{{topic}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Processing time (p95)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "pitchlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pitchlab-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, topic) (rate(kafka_message_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Dead letters",
      "description": "Should stay at zero. Anything here is a message the pipeline could not process and gave up on.",
      "datasource": {
        "type": "prometheus",
        "uid": "pitchlab-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pitchlab-prometheus"
          },
          "expr": "sum by (topic, error_class) (increase(kafka_dlq_messages_total[5m]))",
          "legendFormat": "{{topic}} {{error_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Produce errors",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "pitchlab-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pitchlab-prometheus"
          },
          "expr": "sum by (topic) (rate(kafka_produce_errors_total[1m]))",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Duplicates skipped",
      "description": "Evidence that at-least-once delivery is being absorbed rather than producing duplicate rows.",
      "datasource": {
        "type": "prometheus",
        "uid": "pitchlab-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pitchlab-prometheus"
          },
          "expr": "increase(pitch_duplicates_skipped_total[5m])",
          "legendFormat": "skipped",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Pitch persist latency (p95)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "pitchlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pitchlab-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pitch_persist_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Predictions written",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "pitchlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pitchlab-prometheus"
          },
          "expr": "sum by (model_variant) (rate(predictions_generated_total[1m]))",
          "legendFormat": "{{model_variant}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 8,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ],
  "editable": true
}
